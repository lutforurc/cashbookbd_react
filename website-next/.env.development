# Local development configuration.
#
# ⚠️ EXPLICIT, never guessed. On localhost:3000 there is no company host, so the
# company this developer instance represents has to be named. It must not be
# inferred from "the first company in the database" -- a multi-company database
# would then silently show the wrong company's website.
#
# Point SITE_HOST at the company whose website you are working on (it must have
# a seeded, published site in the local Laravel database).
SITE_HOST=aft.cashbookbd.test

# The local Laravel install.
LARAVEL_INTERNAL_URL=http://127.0.0.1:8123

# Proxy /api and /sanctum to Laravel, since there is no nginx in front of the
# dev server.
NEXT_DEV_PROXY=1
