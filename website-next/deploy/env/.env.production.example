# Per-tenant production environment for the Next.js website.
# Copy to <deploy dir>/website-next/.env.production and edit per tenant.

# The port this tenant's process listens on (3100 + tenant offset).
PORT=3100

# The host this process serves. Informational on the server side; the request
# Host is what actually decides the company. Kept for logs and fallbacks.
SITE_HOST=aft.cashbookbd.com

# This tenant's own Laravel, over the loopback so no request leaves the box and
# the process can only ever read this tenant's database.
LARAVEL_INTERNAL_URL=http://127.0.0.1:8123

# Shared secret Laravel uses to ask this process to drop a cached page after a
# publish (matches SITE_NEXT_REVALIDATE_SECRET in the tenant's Laravel .env).
# Empty disables on-demand revalidation.
REVALIDATE_SECRET=

# Never set NEXT_DEV_PROXY in production: nginx routes /api and /sanctum to
# Laravel, the proxy is a local-development convenience only.
