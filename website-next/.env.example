# The tenant's Laravel install, reached over the internal address so no request
# leaves the box. The visitor's real host is forwarded as X-Site-Host per call.
LARAVEL_INTERNAL_URL=http://127.0.0.1:8123

# The company host this process resolves when the request carries no company
# host of its own -- i.e. a loopback host such as localhost:3000 during local
# development. It is EXPLICIT on purpose: picking "the first company" would show
# the wrong website on a database that holds several.
#
#   development : set it to the company you are working on (see .env.development)
#   production  : leave it empty on a multi-company install; the request Host
#                 decides. A one-company install may set it to its own host.
SITE_HOST=

# Shared secret Laravel uses to ask this process to drop a cached page after a
# publish. Leave empty to disable on-demand revalidation.
REVALIDATE_SECRET=

# Local development only: proxy /api, /sanctum, /login and /site_media to
# Laravel, since there is no nginx in front of the dev server.
NEXT_DEV_PROXY=1
