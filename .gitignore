# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# .gitignore
.env

node_modules
dist
dist-ssr
*.local
/vendor
*.zip

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

# Word writes an owner file beside any document it has open, and deletes it on
# close. It is a lock, not content -- committing one leaves a stale lock in the
# repository for everyone who checks it out.
~$*
